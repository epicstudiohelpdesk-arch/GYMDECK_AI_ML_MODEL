    <string name="voice_notice_setup_title">Asistente de voz</string>
    <string name="voice_notice_setup_body">Habla para registrar comidas, escanear alimentos y códigos de barras y preguntar por tu progreso. El asistente de voz funciona con un plan Fud AI Plus o Pro, o con tu propia clave API de Gemini, OpenAI, xAI o Qwen.</string>
    <string name="voice_notice_missing_key_title">Añade tu clave de %1$s</string>
    <string name="voice_notice_missing_key_body">El asistente de voz está configurado para usar %1$s, que necesita tu clave API. Añádela en Proveedores de IA o elige otro proveedor en los ajustes del asistente de voz.</string>
    <string name="voice_notice_subscription_title">La voz de Fud AI necesita un plan Plus o Pro</string>
    <string name="voice_notice_subscription_body">La voz alojada por Fud AI está incluida en Plus (20 minutos al mes) y Pro (100 minutos al mes). También puedes usar tu propia clave de Gemini, OpenAI, xAI o Qwen.</string>
    <string name="voice_notice_minutes_title">Te quedaste sin minutos de voz</string>
    <string name="voice_notice_minutes_body">Ya usaste los minutos de voz de tu plan este mes. Compra créditos para seguir hablando (4 créditos por minuto) o usa tu propia clave de Gemini, OpenAI, xAI o Qwen.</string>
    <string name="voice_notice_limit_title">Se alcanzó el límite de la conversación</string>
    <string name="voice_notice_limit_body">Esta conversación llegó al límite de 15 minutos. Empieza otra para continuar.</string>
    <string name="voice_notice_mic_title">Se necesita acceso al micrófono</string>
    <string name="voice_notice_mic_body">Permite que Fud AI use el micrófono en los ajustes del sistema para hablar con el asistente.</string>
    <string name="voice_notice_mic_busy_title">El micrófono no está disponible.</string>
    <string name="voice_notice_mic_busy_body">Puede que otra app esté usando el micrófono. Ciérrala e inténtalo de nuevo.</string>
    <string name="voice_notice_key_rejected_title">%1$s rechazó la clave</string>
    <string name="voice_notice_key_rejected_body">Comprueba tu clave API de %1$s, su facturación y su acceso a los modelos de voz en directo en Proveedores de IA.</string>
    <string name="voice_notice_unauthorized_title">No se pudo verificar tu plan</string>
    <string name="voice_notice_unauthorized_body">Fud AI no pudo verificar tu suscripción. Prueba Restaurar compras en Ajustes → Acceso a IA.</string>
    <string name="voice_notice_busy_title">Demasiadas solicitudes</string>
    <string name="voice_notice_busy_body">Hay demasiadas sesiones de voz ahora mismo. Inténtalo de nuevo en un minuto.</string>
    <string name="voice_notice_unavailable_title">La voz no está disponible ahora. Inténtalo más tarde.</string>
    <string name="voice_notice_unavailable_body">El servicio de voz tuvo un problema. Inténtalo de nuevo.</string>
    <string name="voice_notice_connect_title">No se pudo conectar</string>
    <string name="voice_notice_connect_body">No se pudo conectar con el servicio de voz. Revisa tu conexión e inténtalo de nuevo.</string>
    <string name="voice_notice_lost_title">La conexión de voz terminó.</string>
    <string name="voice_notice_lost_body">La conexión de voz terminó. Revisa tu conexión a internet e inténtalo de nuevo.</string>

