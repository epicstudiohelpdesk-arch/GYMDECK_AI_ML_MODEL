    <string name="voice_settings_key_missing">कोई %1$s API कुंजी सहेजी नहीं गई</string>
    <string name="voice_settings_needs_plan">Fud AI वॉइस के लिए Plus या Pro प्लान चाहिए</string>
    <string name="voice_settings_needs_setup">Plus या Pro की सदस्यता लें, या Gemini, OpenAI, xAI या Qwen API कुंजी जोड़ें</string>
    <string name="voice_settings_automatic_footer">स्वचालित, AI प्रदाता में चुने गए प्रदाता का उपयोग करता है जब वह Gemini, OpenAI, xAI या Qwen हो और उसकी कुंजी सहेजी गई हो; वरना Plus या Pro प्लान के साथ Fud AI। आपकी अपनी कुंजियाँ वही हैं जो AI प्रदाता में सहेजी गई हैं।</string>
    <string name="voice_settings_auto_capture">फ़ोटो अपने-आप लेना</string>
    <string name="voice_settings_auto_capture_footer">कैमरा खुला होने पर असिस्टेंट खाना दिखते ही फ़ोटो ले लेता है। Gemini, Qwen और Fud AI कैमरा लगातार देखते हैं; OpenAI हर बार जब आप बोलते हैं; xAI और GPT-Live इसे नहीं देख सकते।</string>
    <string name="voice_settings_confirm_saves">सहेजने से पहले पुष्टि</string>
    <string name="voice_settings_confirm_saves_footer">हर लॉग या बदलाव की मंज़ूरी के लिए एक कार्ड दिखाएँ। इसे बंद करने पर बदलाव तुरंत सेव होते हैं और 8 सेकंड तक वापस किए जा सकते हैं।</string>
    <string name="voice_settings_save_to_coach">बातचीत कोच में सहेजें</string>
    <string name="voice_settings_save_to_coach_footer">आप और असिस्टेंट जो कहते हैं, उसे आपकी कोच चैट में जोड़ता है।</string>
    <string name="voice_settings_minutes_left">प्लान के बचे मिनट</string>
    <string name="voice_settings_minutes_with_credits">%1$s + क्रेडिट से %2$s</string>
    <string name="voice_settings_minutes_footer">Plus में हर महीने 20 मिनट और Pro में 100 मिनट शामिल हैं (UTC)। उसके बाद वॉइस क्रेडिट इस्तेमाल करता है: हर 15 सेकंड पर 1 क्रेडिट।</string>
    <string name="voice_settings_open_title">इसे और जल्दी खोलें</string>
    <string name="voice_settings_open_body">होम पर गोले को टैप करें, तुरंत सेटिंग में Fud AI से बात करें टाइल जोड़ें, ऐप आइकन को दबाकर रखें और Fud AI से बात करें चुनें, या होम स्क्रीन पर विजेट जोड़ें। हर विकल्प तुरंत सुनना शुरू कर देता है।</string>
    <string name="voice_settings_add_tile">तुरंत सेटिंग में टाइल जोड़ें</string>
    <string name="voice_settings_add_widget">होम स्क्रीन पर विजेट जोड़ें</string>
    <string name="voice_settings_privacy_footer">आपकी आवाज़, कैप्शन, असिस्टेंट को दिखने वाले कैमरा फ़्रेम और उसकी कार्रवाइयों के नतीजे आपके चुने प्रदाता को भेजे जाते हैं (Fud AI Plus/Pro के लिए Google)। Fud AI का सर्वर उपयोग की गणना और बिलिंग रसीदें रखता है, बातचीत की सामग्री नहीं।</string>

    <!-- Voice preview -->
    <string name="voice_preview_start">आवाज़ सुनें</string>
    <string name="voice_preview_stop">नमूना बंद करें</string>
    <string name="voice_preview_preparing">नमूना तैयार हो रहा है…</string>
    <string name="voice_preview_sample">नमस्ते, मैं आपका Fud AI सहायक हूँ। मेरी आवाज़ ऐसी है।</string>
    <string name="voice_preview_failed">आवाज़ का यह नमूना चलाया नहीं जा सका। कृपया फिर कोशिश करें।</string>
    <string name="voice_preview_busy">आवाज़ का नमूना सुनने से पहले अपनी मौजूदा वॉइस बातचीत समाप्त करें।</string>
    <string name="voice_preview_usage">आपके माइक्रोफ़ोन का इस्तेमाल किए बिना एक छोटा नमूना सुनाता है। इसमें API क्रेडिट या Fud AI के वॉइस मिनट खर्च होते हैं।</string>
