    <string name="voice_notice_setup_title">Assistente vocale</string>
    <string name="voice_notice_setup_body">Parla per registrare i pasti, scansionare cibi e codici a barre e chiedere dei tuoi progressi. L’assistente vocale funziona con un piano Fud AI Plus o Pro, oppure con la tua chiave API di Gemini, OpenAI, xAI o Qwen.</string>
    <string name="voice_notice_missing_key_title">Aggiungi la tua chiave %1$s</string>
    <string name="voice_notice_missing_key_body">L’assistente vocale è impostato su %1$s, che richiede la tua chiave API. Aggiungila in Provider IA oppure scegli un altro provider nelle impostazioni dell’assistente vocale.</string>
    <string name="voice_notice_subscription_title">La voce di Fud AI richiede un piano Plus o Pro</string>
    <string name="voice_notice_subscription_body">La voce ospitata da Fud AI è inclusa in Plus (20 minuti al mese) e Pro (100 minuti al mese). Puoi anche usare la tua chiave Gemini, OpenAI, xAI o Qwen.</string>
    <string name="voice_notice_minutes_title">Hai finito i minuti vocali</string>
    <string name="voice_notice_minutes_body">Hai esaurito i minuti vocali del tuo piano per questo mese. Acquista crediti per continuare a parlare (4 crediti al minuto) o usa la tua chiave di Gemini, OpenAI, xAI o Qwen.</string>
    <string name="voice_notice_limit_title">Limite della conversazione raggiunto</string>
    <string name="voice_notice_limit_body">Questa conversazione ha raggiunto il limite di 15 minuti. Avviane una nuova per continuare.</string>
    <string name="voice_notice_mic_title">È necessario l’accesso al microfono</string>
    <string name="voice_notice_mic_body">Consenti a Fud AI di usare il microfono nelle impostazioni di sistema per parlare con l’assistente.</string>
    <string name="voice_notice_mic_busy_title">Il microfono non è disponibile.</string>
    <string name="voice_notice_mic_busy_body">Un’altra app potrebbe usare il microfono. Chiudila e riprova.</string>
    <string name="voice_notice_key_rejected_title">%1$s ha rifiutato la chiave</string>
    <string name="voice_notice_key_rejected_body">Controlla la tua chiave API %1$s, la fatturazione e l’accesso ai modelli vocali in tempo reale in Provider IA.</string>
    <string name="voice_notice_unauthorized_title">Impossibile verificare il tuo piano</string>
    <string name="voice_notice_unauthorized_body">Fud AI non è riuscito a verificare il tuo abbonamento. Prova Ripristina acquisti in Impostazioni → Accesso IA.</string>
    <string name="voice_notice_busy_title">Troppe richieste</string>
    <string name="voice_notice_busy_body">Troppe sessioni vocali in questo momento. Riprova tra un minuto.</string>
    <string name="voice_notice_unavailable_title">La voce non è disponibile ora. Riprova più tardi.</string>
    <string name="voice_notice_unavailable_body">Il servizio vocale ha avuto un problema. Riprova.</string>
    <string name="voice_notice_connect_title">Impossibile connettersi</string>
    <string name="voice_notice_connect_body">Impossibile connettersi al servizio vocale. Controlla la connessione e riprova.</string>
    <string name="voice_notice_lost_title">La connessione vocale si è interrotta.</string>
    <string name="voice_notice_lost_body">La connessione vocale si è interrotta. Controlla la connessione a Internet e riprova.</string>

