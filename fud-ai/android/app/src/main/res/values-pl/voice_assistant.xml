    <string name="voice_notice_setup_title">Asystent głosowy</string>
    <string name="voice_notice_setup_body">Mów, aby zapisywać posiłki, skanować jedzenie i kody kreskowe oraz pytać o postępy. Asystent głosowy działa w planie Fud AI Plus lub Pro albo z twoim własnym kluczem API Gemini, OpenAI, xAI lub Qwen.</string>
    <string name="voice_notice_missing_key_title">Dodaj klucz %1$s</string>
    <string name="voice_notice_missing_key_body">Asystent głosowy korzysta z %1$s, co wymaga Twojego klucza API. Dodaj go w sekcji Dostawcy AI lub wybierz innego dostawcę w ustawieniach asystenta głosowego.</string>
    <string name="voice_notice_subscription_title">Głos Fud AI wymaga planu Plus lub Pro</string>
    <string name="voice_notice_subscription_body">Rozmowy głosowe obsługiwane przez Fud AI są dostępne w planach Plus (20 minut miesięcznie) i Pro (100 minut miesięcznie). Możesz też użyć własnego klucza Gemini, OpenAI, xAI lub Qwen.</string>
    <string name="voice_notice_minutes_title">Skończyły ci się minuty głosowe</string>
    <string name="voice_notice_minutes_body">Minuty głosowe twojego planu na ten miesiąc się wyczerpały. Kup kredyty, aby rozmawiać dalej (4 kredyty za minutę), albo użyj własnego klucza Gemini, OpenAI, xAI lub Qwen.</string>
    <string name="voice_notice_limit_title">Osiągnięto limit rozmowy</string>
    <string name="voice_notice_limit_body">Ta rozmowa osiągnęła limit 15 minut. Zacznij nową, aby kontynuować.</string>
    <string name="voice_notice_mic_title">Potrzebny dostęp do mikrofonu</string>
    <string name="voice_notice_mic_body">Aby rozmawiać z asystentem, zezwól Fud AI na korzystanie z mikrofonu w ustawieniach systemowych.</string>
    <string name="voice_notice_mic_busy_title">Mikrofon jest niedostępny.</string>
    <string name="voice_notice_mic_busy_body">Inna aplikacja może korzystać z mikrofonu. Zamknij ją i spróbuj ponownie.</string>
    <string name="voice_notice_key_rejected_title">%1$s odrzucił klucz</string>
    <string name="voice_notice_key_rejected_body">W sekcji Dostawcy AI sprawdź klucz API %1$s, jego rozliczenia i dostęp do modeli rozmów głosowych na żywo.</string>
    <string name="voice_notice_unauthorized_title">Nie udało się zweryfikować planu</string>
    <string name="voice_notice_unauthorized_body">Fud AI nie mogło potwierdzić twojej subskrypcji. Spróbuj opcji Przywróć zakupy w Ustawienia → Dostęp AI.</string>
    <string name="voice_notice_busy_title">Zbyt wiele żądań</string>
    <string name="voice_notice_busy_body">Za dużo sesji głosowych w tej chwili. Spróbuj ponownie za minutę.</string>
    <string name="voice_notice_unavailable_title">Głos jest teraz niedostępny. Spróbuj ponownie później.</string>
    <string name="voice_notice_unavailable_body">Usługa głosowa napotkała problem. Spróbuj ponownie.</string>
    <string name="voice_notice_connect_title">Nie udało się połączyć</string>
    <string name="voice_notice_connect_body">Nie udało się połączyć z usługą głosową. Sprawdź połączenie i spróbuj ponownie.</string>
    <string name="voice_notice_lost_title">Połączenie głosowe zostało zakończone.</string>
    <string name="voice_notice_lost_body">Połączenie głosowe zostało zakończone. Sprawdź połączenie z internetem i spróbuj ponownie.</string>

