    <string name="voice_notice_setup_title">Assistente de voz</string>
    <string name="voice_notice_setup_body">Fale para registrar refeições, escanear alimentos e códigos de barras e perguntar sobre seu progresso. O assistente de voz funciona com um plano Fud AI Plus ou Pro, ou com sua própria chave de API do Gemini, OpenAI, xAI ou Qwen.</string>
    <string name="voice_notice_missing_key_title">Adicione sua chave do %1$s</string>
    <string name="voice_notice_missing_key_body">O assistente de voz está configurado para %1$s, que precisa da sua chave de API. Adicione-a em Provedores de IA ou escolha outro provedor nas configurações do assistente de voz.</string>
    <string name="voice_notice_subscription_title">A voz do Fud AI exige um plano Plus ou Pro</string>
    <string name="voice_notice_subscription_body">A voz hospedada pelo Fud AI está incluída no Plus (20 minutos por mês) e no Pro (100 minutos por mês). Você também pode usar sua própria chave do Gemini, OpenAI, xAI ou Qwen.</string>
    <string name="voice_notice_minutes_title">Seus minutos de voz acabaram</string>
    <string name="voice_notice_minutes_body">Os minutos de voz do seu plano acabaram este mês. Compre créditos para continuar falando (4 créditos por minuto) ou use sua própria chave do Gemini, OpenAI, xAI ou Qwen.</string>
    <string name="voice_notice_limit_title">Limite da conversa atingido</string>
    <string name="voice_notice_limit_body">Esta conversa chegou ao limite de 15 minutos. Comece outra para continuar.</string>
    <string name="voice_notice_mic_title">É necessário acesso ao microfone</string>
    <string name="voice_notice_mic_body">Permita que o Fud AI use o microfone nas configurações do sistema para conversar com o assistente.</string>
    <string name="voice_notice_mic_busy_title">O microfone não está disponível.</string>
    <string name="voice_notice_mic_busy_body">Outro app pode estar usando o microfone. Feche-o e tente novamente.</string>
    <string name="voice_notice_key_rejected_title">%1$s rejeitou a chave</string>
    <string name="voice_notice_key_rejected_body">Confira sua chave de API do %1$s, o faturamento e o acesso aos modelos de voz ao vivo em Provedores de IA.</string>
    <string name="voice_notice_unauthorized_title">Não foi possível verificar seu plano</string>
    <string name="voice_notice_unauthorized_body">O Fud AI não conseguiu confirmar sua assinatura. Tente Restaurar Compras em Ajustes → Acesso à IA.</string>
    <string name="voice_notice_busy_title">Muitas solicitações</string>
    <string name="voice_notice_busy_body">Há sessões de voz demais agora. Tente de novo em um minuto.</string>
    <string name="voice_notice_unavailable_title">A voz não está disponível agora. Tente de novo mais tarde.</string>
    <string name="voice_notice_unavailable_body">O serviço de voz teve um problema. Tente de novo.</string>
    <string name="voice_notice_connect_title">Não foi possível conectar</string>
    <string name="voice_notice_connect_body">Não foi possível conectar ao serviço de voz. Verifique sua conexão e tente de novo.</string>
    <string name="voice_notice_lost_title">A conexão de voz foi encerrada.</string>
    <string name="voice_notice_lost_body">A conexão de voz foi encerrada. Verifique sua conexão com a internet e tente de novo.</string>

