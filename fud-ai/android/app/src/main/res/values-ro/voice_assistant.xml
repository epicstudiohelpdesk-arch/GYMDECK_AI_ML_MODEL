    <string name="voice_notice_setup_title">Asistent vocal</string>
    <string name="voice_notice_setup_body">Vorbește ca să înregistrezi mese, să scanezi alimente și coduri de bare și să întrebi despre progresul tău. Asistentul vocal funcționează cu un plan Fud AI Plus sau Pro ori cu propria ta cheie API Gemini, OpenAI, xAI sau Qwen.</string>
    <string name="voice_notice_missing_key_title">Adaugă cheia ta %1$s</string>
    <string name="voice_notice_missing_key_body">Asistentul vocal este setat pe %1$s, care necesită cheia ta API. Adaug-o la Furnizori AI sau alege alt furnizor în setările asistentului vocal.</string>
    <string name="voice_notice_subscription_title">Vocea Fud AI necesită un plan Plus sau Pro</string>
    <string name="voice_notice_subscription_body">Vocea găzduită de Fud AI este inclusă în Plus (20 de minute pe lună) și Pro (100 de minute pe lună). Poți folosi și propria cheie Gemini, OpenAI, xAI sau Qwen.</string>
    <string name="voice_notice_minutes_title">Ai rămas fără minute vocale</string>
    <string name="voice_notice_minutes_body">Minutele vocale ale planului tău pentru luna aceasta s-au terminat. Cumpără credite ca să vorbești în continuare (4 credite pe minut) sau folosește-ți propria cheie Gemini, OpenAI, xAI ori Qwen.</string>
    <string name="voice_notice_limit_title">Limita conversației a fost atinsă</string>
    <string name="voice_notice_limit_body">Această conversație a atins limita de 15 minute. Începe una nouă ca să continui.</string>
    <string name="voice_notice_mic_title">Este necesar accesul la microfon</string>
    <string name="voice_notice_mic_body">Permite Fud AI să folosească microfonul din setările sistemului pentru a vorbi cu asistentul.</string>
    <string name="voice_notice_mic_busy_title">Microfonul nu este disponibil.</string>
    <string name="voice_notice_mic_busy_body">Este posibil ca altă aplicație să folosească microfonul. Închide-o și încearcă din nou.</string>
    <string name="voice_notice_key_rejected_title">%1$s a respins cheia</string>
    <string name="voice_notice_key_rejected_body">Verifică cheia API %1$s, facturarea și accesul la modelele vocale în timp real în Furnizori AI.</string>
    <string name="voice_notice_unauthorized_title">Planul tău nu a putut fi verificat</string>
    <string name="voice_notice_unauthorized_body">Fud AI nu ți-a putut confirma abonamentul. Încearcă Restaurează achizițiile în Setări → Acces AI.</string>
    <string name="voice_notice_busy_title">Prea multe cereri</string>
    <string name="voice_notice_busy_body">Sunt prea multe sesiuni vocale acum. Încearcă din nou peste un minut.</string>
    <string name="voice_notice_unavailable_title">Vocea nu este disponibilă acum. Încearcă din nou mai târziu.</string>
    <string name="voice_notice_unavailable_body">Serviciul vocal a întâmpinat o problemă. Încearcă din nou.</string>
    <string name="voice_notice_connect_title">Conectarea nu a reușit</string>
    <string name="voice_notice_connect_body">Nu s-a putut face conexiunea la serviciul vocal. Verifică-ți conexiunea și încearcă din nou.</string>
    <string name="voice_notice_lost_title">Conexiunea vocală s-a încheiat.</string>
    <string name="voice_notice_lost_body">Conexiunea vocală s-a încheiat. Verifică-ți conexiunea la internet și încearcă din nou.</string>

