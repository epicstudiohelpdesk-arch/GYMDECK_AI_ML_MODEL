    <string name="voice_action_open_settings">打开设置</string>
    <string name="voice_notice_setup_title">语音助手</string>
    <string name="voice_notice_setup_body">开口即可记录餐食、扫描食物和条形码，并询问你的进展。语音助手需要 Fud AI Plus 或 Pro 订阅，或你自己的 Gemini、OpenAI、xAI 或 Qwen API 密钥。</string>
    <string name="voice_notice_missing_key_title">添加你的 %1$s 密钥</string>
    <string name="voice_notice_missing_key_body">语音助手已设为 %1$s，需要你的 API 密钥。请在“AI 提供商”中添加，或在语音助手设置中选择其他提供商。</string>
    <string name="voice_notice_subscription_title">Fud AI 语音需要 Plus 或 Pro 订阅</string>
    <string name="voice_notice_subscription_body">Fud AI 托管语音包含在 Plus（每月 20 分钟）和 Pro（每月 100 分钟）中。你也可以使用自己的 Gemini、OpenAI、xAI 或 Qwen 密钥。</string>
    <string name="voice_notice_minutes_title">语音时长已用完</string>
    <string name="voice_notice_minutes_body">本月订阅方案的语音时长已用完。购买点数即可继续对话（每分钟 4 点），或使用你自己的 Gemini、OpenAI、xAI 或 Qwen 密钥。</string>
    <string name="voice_notice_limit_title">已达到对话时限</string>
    <string name="voice_notice_limit_body">本次对话已达到 15 分钟上限。开始新的对话即可继续。</string>
    <string name="voice_notice_mic_title">需要麦克风权限</string>
    <string name="voice_notice_mic_body">请在系统设置中允许 Fud AI 使用麦克风，以便与助手对话。</string>
    <string name="voice_notice_mic_busy_title">麦克风不可用。</string>
    <string name="voice_notice_mic_busy_body">其他应用可能正在使用麦克风。请关闭该应用后重试。</string>
    <string name="voice_notice_key_rejected_title">%1$s 拒绝了该密钥</string>
    <string name="voice_notice_key_rejected_body">请在“AI 提供商”中检查你的 %1$s API 密钥、计费状态以及实时语音模型的访问权限。</string>
    <string name="voice_notice_unauthorized_title">无法验证你的套餐</string>
    <string name="voice_notice_unauthorized_body">Fud AI 无法验证你的订阅。请在“设置 → AI 访问”中尝试“恢复购买”。</string>
    <string name="voice_notice_busy_title">请求过多</string>
    <string name="voice_notice_busy_body">当前语音会话过多。请一分钟后再试。</string>
    <string name="voice_notice_unavailable_title">语音暂时不可用。请稍后再试。</string>
    <string name="voice_notice_unavailable_body">语音服务出现问题。请重试。</string>
    <string name="voice_notice_connect_title">无法连接</string>
    <string name="voice_notice_connect_body">无法连接语音服务。请检查网络连接后重试。</string>
    <string name="voice_notice_lost_title">语音连接已结束。</string>
    <string name="voice_notice_lost_body">语音连接已结束。请检查网络连接后重试。</string>

