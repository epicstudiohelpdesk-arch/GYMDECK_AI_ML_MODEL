    <string name="voice_notice_setup_title">Voice Assistant</string>
    <string name="voice_notice_setup_body">Talk to log meals, scan food and barcodes, and ask about your progress. The voice assistant runs on a Fud AI Plus or Pro plan, or on your own Gemini, OpenAI, xAI or Qwen API key.</string>
    <string name="voice_notice_missing_key_title">Add your %1$s key</string>
    <string name="voice_notice_missing_key_body">The voice assistant is set to %1$s, which needs your API key. Add it in AI Providers, or choose another provider in Voice Assistant settings.</string>
    <string name="voice_notice_subscription_title">Fud AI voice needs a Plus or Pro plan</string>
    <string name="voice_notice_subscription_body">Voice hosted by Fud AI comes with Plus (20 minutes a month) and Pro (100 minutes a month). You can also use your own Gemini, OpenAI, xAI or Qwen key.</string>
    <string name="voice_notice_minutes_title">You\'re out of voice minutes</string>
    <string name="voice_notice_minutes_body">Your plan\'s voice minutes for this month are used up. Buy credits to keep talking (4 credits a minute), or use your own Gemini, OpenAI, xAI or Qwen key.</string>
    <string name="voice_notice_limit_title">Conversation limit reached</string>
    <string name="voice_notice_limit_body">This conversation reached the 15-minute limit. Start a new one to keep going.</string>
    <string name="voice_notice_mic_title">Microphone access needed</string>
    <string name="voice_notice_mic_body">Allow Fud AI to use the microphone in system settings to talk with the assistant.</string>
    <string name="voice_notice_mic_busy_title">The microphone isn\'t available.</string>
    <string name="voice_notice_mic_busy_body">Another app may be using the microphone. Close it and try again.</string>
    <string name="voice_notice_key_rejected_title">%1$s rejected the key</string>
    <string name="voice_notice_key_rejected_body">Check your %1$s API key, its billing and its access to live voice models in AI Providers.</string>
    <string name="voice_notice_unauthorized_title">Couldn’t verify your plan</string>
    <string name="voice_notice_unauthorized_body">Fud AI couldn\'t verify your subscription. Try Restore Purchases in Settings → AI Access.</string>
    <string name="voice_notice_busy_title">Too many requests</string>
    <string name="voice_notice_busy_body">Too many voice sessions right now. Try again in a minute.</string>
    <string name="voice_notice_unavailable_title">Voice is unavailable right now. Try again later.</string>
    <string name="voice_notice_unavailable_body">The voice service had a problem. Try again.</string>
    <string name="voice_notice_connect_title">Couldn’t connect</string>
    <string name="voice_notice_connect_body">Couldn\'t connect to the voice service. Check your connection and try again.</string>
    <string name="voice_notice_lost_title">The voice connection ended.</string>
    <string name="voice_notice_lost_body">The voice connection ended. Check your internet connection and try again.</string>

