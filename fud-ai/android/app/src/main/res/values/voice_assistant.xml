    <string name="voice_settings_needs_plan">Fud AI voice needs a Plus or Pro plan</string>
    <string name="voice_settings_needs_setup">Subscribe to Plus or Pro, or add a Gemini, OpenAI, xAI or Qwen API key</string>
    <string name="voice_settings_automatic_footer">Automatic uses the provider selected in AI Providers when it\'s Gemini, OpenAI, xAI or Qwen and its key is saved; otherwise Fud AI with a Plus or Pro plan. Own keys are the ones saved in AI Providers.</string>
    <string name="voice_settings_auto_capture">Auto-Capture Photos</string>
    <string name="voice_settings_auto_capture_footer">When the camera is open, the assistant takes the photo as soon as it sees the food. Gemini, Qwen and Fud AI see the camera continuously; OpenAI each time you speak; xAI and GPT-Live can\'t see it.</string>
    <string name="voice_settings_confirm_saves">Confirm Before Saving</string>
    <string name="voice_settings_confirm_saves_footer">Show a card to approve each log or change. When off, changes save right away with an 8-second Undo.</string>
    <string name="voice_settings_save_to_coach">Save Conversations to Coach</string>
    <string name="voice_settings_save_to_coach_footer">Adds what you and the assistant say to your Coach chat.</string>
    <string name="voice_settings_minutes_left">Plan Minutes Left</string>
    <string name="voice_settings_minutes_unknown" translatable="false">—</string>
    <string name="voice_settings_minutes_with_credits">%1$s + %2$s from credits</string>
    <string name="voice_settings_minutes_footer">Plus includes 20 minutes and Pro 100 minutes a month (UTC). After that, voice uses credits: 1 credit per 15 seconds.</string>
    <string name="voice_settings_open_title">Open It Faster</string>
    <string name="voice_settings_open_body">Tap the orb on Home, add the Talk to Fud AI tile to Quick Settings, long-press the app icon and choose Talk to Fud AI, or add the widget to your home screen. Each one starts listening right away.</string>
    <string name="voice_settings_add_tile">Add Quick Settings Tile</string>
    <string name="voice_settings_add_widget">Add Home Screen Widget</string>
    <string name="voice_settings_privacy_footer">Your voice, captions, the camera frames the assistant sees and the results of its actions go to the provider you use (Google for Fud AI Plus/Pro). Fud AI’s server keeps usage counters and billing receipts, not conversation content.</string>

