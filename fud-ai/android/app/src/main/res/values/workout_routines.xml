    <string name="workout_routines_footer">Adds the routine\'s exercises to the selected day. Sets you already logged stay as they are.</string>
    <!-- Action that renames a saved routine. -->
    <string name="workout_routine_rename">Rename</string>
    <!-- Title of the dialog that renames a routine. -->
    <string name="workout_routine_rename_title">Rename Routine</string>
    <!-- Confirmation title before deleting a routine. -->
    <string name="workout_routine_delete_title">Delete Routine?</string>
    <!-- Confirmation message before deleting a routine. -->
    <string name="workout_routine_delete_message">Workouts you already logged are kept.</string>
