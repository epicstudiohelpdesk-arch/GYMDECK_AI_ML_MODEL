    "Protein, carbs, and fat on your watch face." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "البروتين والكربوهيدرات والدهون على واجهة ساعتك." } },
        "az" : { "stringUnit" : { "state" : "translated", "value" : "Zülal, karbohidrat və yağ saatınızın siferblatında." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Bílkoviny, sacharidy a tuky na ciferníku hodinek." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Protein, Kohlenhydrate und Fett auf deinem Zifferblatt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Protein, carbs, and fat on your watch face." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Proteína, carbohidratos y grasa en tu esfera." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Protéines, glucides et lipides sur ton cadran." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके वॉच फ़ेस पर प्रोटीन, कार्ब्स और फैट।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Proteine, carboidrati e grassi sul quadrante." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "たんぱく質、炭水化物、脂質を文字盤に表示します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "워치 페이스에 단백질, 탄수화물, 지방을 표시합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Eiwit, koolhydraten en vet op je wijzerplaat." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Białko, węglowodany i tłuszcz na tarczy zegarka." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Proteína, carboidratos e gordura no mostrador." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Proteine, carbohidrați și grăsimi pe cadranul ceasului." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Белки, углеводы и жиры на циферблате." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Saat kadranınızda protein, karbonhidrat ve yağ." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Білки, вуглеводи та жири на циферблаті." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在表盘上显示蛋白质、碳水和脂肪。" } }
      }
    },
    "Today's calories on your watch face." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سعرات اليوم على واجهة ساعتك." } },
        "az" : { "stringUnit" : { "state" : "translated", "value" : "Bugünkü kalorilər saatınızın siferblatında." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Dnešní kalorie na ciferníku hodinek." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Kalorien von heute auf deinem Zifferblatt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Today's calories on your watch face." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las calorías de hoy en tu esfera." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les calories du jour sur ton cadran." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके वॉच फ़ेस पर आज की कैलोरी।" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Le calorie di oggi sul quadrante." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "今日のカロリーを文字盤に表示します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "워치 페이스에 오늘의 칼로리를 표시합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De calorieën van vandaag op je wijzerplaat." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Dzisiejsze kalorie na tarczy zegarka." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As calorias de hoje no mostrador." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Caloriile de azi pe cadranul ceasului." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Калории за сегодня на циферблате." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bugünkü kaloriler saat kadranınızda." } },
