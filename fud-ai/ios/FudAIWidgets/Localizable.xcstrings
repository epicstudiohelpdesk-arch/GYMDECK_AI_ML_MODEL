    "See today's calories and macros at a glance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطّلع على سعرات اليوم وعناصرها الكبرى بلمحة سريعة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü kaloriləri və makroları bir baxışda görün."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní kalorie a makroživiny na první pohled."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh die Kalorien und Makros von heute auf einen Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta las calorías y macros de hoy de un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois les calories et macros du jour en un coup d’œil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज की कैलोरी और मैक्रो एक नज़र में देखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calorie e i macro di oggi a colpo d’occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のカロリーとマクロをひと目で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 칼로리와 매크로를 한눈에 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk de calorieën en macro’s van vandaag in één oogopslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejsze kalorie i makroskładniki w jednym spojrzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja as calorias e os macros de hoje num relance."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezi dintr-o privire caloriile și macronutrienții de azi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калории и БЖУ за сегодня — с одного взгляда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük kalori ve makro besinlerinizi bir bakışta görün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калорії та БЖВ за сьогодні — з першого погляду."
          }
        },
